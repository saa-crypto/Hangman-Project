<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox fx:id="menuPane" alignment="CENTER" prefHeight="700" prefWidth="1000" spacing="20" styleClass="menu-root-pane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.quentincillierre.hangman.controller.MenuController">

    <!-- Title Section -->
    <VBox alignment="CENTER" spacing="10">
        <Label styleClass="menu-title" text="🎮 HANGMAN GAME" />
        <Label styleClass="menu-subtitle" text="Guess the word before you run out of lives!" />
    </VBox>

    <!-- Glass Morphic Card - All Controls -->
    <VBox alignment="CENTER" spacing="20" styleClass="menu-card">
        
        <!-- Difficulty Selection -->
        <VBox alignment="CENTER" spacing="10">
            <Label styleClass="menu-label" text="Select Difficulty:" />
            <ComboBox fx:id="difficultyComboBox" prefWidth="220" styleClass="menu-combo" />
        </VBox>

        <!-- Buttons Section -->
        <VBox alignment="CENTER" spacing="12">
            <Button fx:id="playButton" prefWidth="220" prefHeight="50" styleClass="play-button" text="▶ PLAY" />
            <Button fx:id="rulesButton" prefWidth="220" prefHeight="50" styleClass="menu-button" text="📖 RULES" />
            <Button fx:id="statsButton" prefWidth="220" prefHeight="50" styleClass="menu-button" text="📊 STATS" />
            <Button fx:id="exitButton" prefWidth="220" prefHeight="50" styleClass="exit-button" text="❌ EXIT" />
        </VBox>
        
    </VBox>

    <!-- Footer -->
    <Label styleClass="menu-footer" text="Good luck! 🍀" />

</VBox>