<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="rootPane" alignment="TOP_CENTER" prefHeight="700" prefWidth="1000" spacing="8" styleClass="root-pane" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.quentincillierre.hangman.controller.GameController">

    <!-- 1. Top Header / Stats Bar -->
    <HBox alignment="CENTER" prefHeight="50.0" prefWidth="1000.0" spacing="20" styleClass="top-header" VBox.vgrow="NEVER">
        <Label fx:id="streakLabel" styleClass="stat-label" text="🔥 Streak: 0" />
        <Label fx:id="scoreLabel" styleClass="stat-label" text="🏆 Score: 0" />
        <Label fx:id="timerLabel" styleClass="timer-label" text="⏱️ 60s" />
        <ComboBox fx:id="difficultyComboBox" prefHeight="25.0" prefWidth="0.0" styleClass="difficulty-combo" />
    </HBox>

    <!-- 2. Main Content Area (Hangman Left + Game Card Right) -->
    <HBox alignment="CENTER" spacing="20" VBox.vgrow="NEVER" prefHeight="280.0" prefWidth="1000.0">
        
        <!-- Left: Hangman Stage Image -->
        <VBox alignment="CENTER" styleClass="hangman-container" prefHeight="280.0" prefWidth="400.0">
            <ImageView fx:id="hangmanImageView" fitHeight="260.0" fitWidth="380" preserveRatio="true" />
        </VBox>

        <!-- Right: Game Card -->
        <VBox alignment="TOP_CENTER" spacing="10" styleClass="game-card" prefHeight="280.0" prefWidth="550.0">
            <Label fx:id="categoryLabel" styleClass="category-label" text="Category: Programming" />
            <Label fx:id="hintLabel" styleClass="hint-display" text="" />
            
            <!-- Lives (Hearts) -->
            <HBox fx:id="livesBox" alignment="CENTER" spacing="6" styleClass="lives-container" />

            <!-- Win / Loss Result Message -->
            <Label fx:id="resultLabel" styleClass="result-label" />

            <!-- Hidden Word Display -->
            <Label fx:id="wordLabel" styleClass="word-display-card" text="_   _   _   _      _" />

            <!-- Control Buttons -->
            <HBox alignment="CENTER" spacing="12">
                <Button fx:id="backButton" prefHeight="26.0" prefWidth="142.0" styleClass="action-btn, back-btn" text="◀ BACK" />
                <Button fx:id="hintButton" onAction="#onHintClicked" prefHeight="26.0" prefWidth="154.0" styleClass="action-btn, hint-action-btn" text="💡 Hint (-1 Life)" />
                <Button fx:id="restartButton" onAction="#onRestartClicked" prefHeight="26.0" prefWidth="118.0" styleClass="action-btn, restart-btn" text="Next Round ▶" visible="false" />
            </HBox>
        </VBox>
    </HBox>

    <!-- 3. Keyboard -->
    <VBox alignment="CENTER" spacing="10" VBox.vgrow="ALWAYS">
        <GridPane fx:id="keyboardGrid" alignment="CENTER" hgap="6" vgap="6" />
    </VBox>
</VBox>
