<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="rootPane" alignment="TOP_CENTER" prefHeight="700" prefWidth="1000" spacing="8" styleClass="root-pane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.quentincillierre.hangman.controller.GameController">

    <!-- Back Button (Top Left) -->
    <HBox alignment="TOP_LEFT" prefHeight="50" prefWidth="1000" VBox.vgrow="NEVER">
        <Button fx:id="backButton" styleClass="back-button" text="◀ BACK" />
    </HBox>

    <!-- 1. Top Header / Stats Bar -->
    <HBox alignment="CENTER" prefHeight="50.0" prefWidth="1000.0" spacing="20" styleClass="top-header" VBox.vgrow="NEVER">
        <Label fx:id="streakLabel" styleClass="stat-label" text="🔥 Streak: 0" />
        <Label fx:id="scoreLabel" styleClass="stat-label" text="🏆 Score: 0" />
        <Label fx:id="timerLabel" styleClass="timer-label" text="⏱️ 60s" />
        <ComboBox fx:id="difficultyComboBox" prefHeight="25.0" prefWidth="0.0" styleClass="difficulty-combo" />
    </HBox>

    <!-- 2. Hangman Stage Image -->
    <VBox alignment="CENTER" minHeight="120.0" prefHeight="140.0" prefWidth="1000.0" VBox.vgrow="NEVER">
        <ImageView fx:id="hangmanImageView" fitHeight="140.0" fitWidth="280" preserveRatio="true" />
    </VBox>

    <!-- 3. Central Category & Game Card -->
    <VBox alignment="CENTER" maxWidth="500.0" spacing="10" styleClass="game-card" VBox.vgrow="NEVER">
        <Label fx:id="categoryLabel" styleClass="category-label" text="Category: Programming" />
        
        <!-- Lives (Hearts) -->
        <HBox fx:id="livesBox" alignment="CENTER" spacing="6" styleClass="lives-container" />

        <!-- Win / Loss Result Message -->
        <Label fx:id="resultLabel" styleClass="result-label" />

        <!-- Control Buttons -->
        <HBox alignment="CENTER" spacing="12">
            <Button fx:id="startButton" onAction="#onStartClicked" styleClass="action-btn, start-btn" text="▶ Start Round" />
            <Button fx:id="restartButton" onAction="#onRestartClicked" styleClass="action-btn, restart-btn" text="Play Again" />
        </HBox>
    </VBox>

    <!-- 4. Hidden Word Display -->
    <Label fx:id="wordLabel" styleClass="word-display" text="_   _   _   _      _" VBox.vgrow="NEVER" />

    <!-- 5. Keyboard & Hint -->
    <VBox alignment="CENTER" spacing="10" VBox.vgrow="ALWAYS">
        <GridPane fx:id="keyboardGrid" alignment="CENTER" hgap="6" vgap="6" />
        <HBox alignment="CENTER">
            <Button fx:id="hintButton" onAction="#onHintClicked" styleClass="hint-button" text="💡 Hint (-1 Life)" />
        </HBox>
    </VBox>
</VBox>
