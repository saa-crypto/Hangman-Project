<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="rootPane" alignment="CENTER" spacing="12" prefWidth="1000" prefHeight="700" 
      styleClass="root-pane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="fr.quentincillierre.hangman.controller.GameController">

    <!-- 1. Top Header / Stats Bar -->
    <HBox alignment="CENTER" spacing="20" styleClass="top-header">
        <Label fx:id="streakLabel" text="🔥 Streak: 0" styleClass="stat-label" />
        <Label fx:id="scoreLabel" text="🏆 Score: 0" styleClass="stat-label" />
        <Label fx:id="timerLabel" text="⏱️ 60s" styleClass="timer-label" />
        <ComboBox fx:id="difficultyComboBox" styleClass="difficulty-combo" />
    </HBox>

    <!-- 2. Hangman Stage Image -->
    <VBox alignment="CENTER" minHeight="180">
        <ImageView fx:id="hangmanImageView" fitHeight="200" fitWidth="300" preserveRatio="true" />
    </VBox>

    <!-- 3. Central Category & Game Card -->
    <VBox alignment="CENTER" spacing="10" styleClass="game-card" maxWidth="450">
        <Label fx:id="categoryLabel" text="Category: Programming" styleClass="category-label" />
        
        <!-- Lives (Hearts) -->
        <HBox fx:id="livesBox" alignment="CENTER" spacing="6" styleClass="lives-container" />

        <!-- Win / Loss Result Message -->
        <Label fx:id="resultLabel" styleClass="result-label" />

        <!-- Control Buttons -->
        <HBox alignment="CENTER" spacing="12">
            <Button fx:id="startButton" text="▶ Start Round" onAction="#onStartClicked" styleClass="action-btn, start-btn" />
            <Button fx:id="restartButton" text="Play Again" onAction="#onRestartClicked" styleClass="action-btn, restart-btn" />
        </HBox>
    </VBox>

    <!-- 4. Hidden Word Display -->
    <Label fx:id="wordLabel" text="_   _   _   _      _" styleClass="word-display" />

    <!-- 5. Keyboard & Hint -->
    <VBox alignment="CENTER" spacing="10">
        <GridPane fx:id="keyboardGrid" alignment="CENTER" hgap="6" vgap="6" />
        <Button fx:id="hintButton" text="💡 Hint (-1 Life)" onAction="#onHintClicked" styleClass="hint-button" />
    </VBox>
</VBox>